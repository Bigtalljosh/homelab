## Global Settings (shared — keep in sync with ../media/.env)
DOCKERCONFDIR=/volume2/docker
DOCKERSTORAGEDIR=/volume2/data

PUID=1000
PGID=100
TZ=Europe/London

# Dockerlogging and max size
DOCKERLOGGING_MAXFILE=10
DOCKERLOGGING_MAXSIZE=200k

## rclone rcd (remote-control daemon)
# Credentials the Rclone UI desktop app uses to connect to http://<nas-ip>:5572.
# SET THESE ON THE NAS — leave blank here so they're never committed.
# The daemon has full read/write access to DOCKERSTORAGEDIR, so use a real password
# and do NOT port-forward 5572 to the internet.
RCLONE_USER=
RCLONE_PASS=

# Parallelism. This is the whole point: one TCP stream to a ~200ms-RTT host (Backblaze)
# caps near 70-80 Mbps no matter how fast your line is. 16 concurrent streams saturate
# gigabit. Lower it if the NAS gets I/O-bound.
RCLONE_TRANSFERS=16
RCLONE_CHECKERS=16
