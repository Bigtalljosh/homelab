## Global Settings (shared across stacks — keep in sync with ../immich/.env and ../home/.env)
DOCKERCONFDIR=/volume2/docker
DOCKERSTORAGEDIR=/volume2/data

# UGREEN UGOS: bigtalljosh = uid 1000; gid 100 = the shared `users` group (same GID as
# Synology, so migrated files keep their group). chown copied data: chown -R 1000:100
PUID=1000
PGID=100
TZ=Europe/London

# Dockerlogging and max size
DOCKERLOGGING_MAXFILE=10
DOCKERLOGGING_MAXSIZE=200k

# <lan ipv4 network>/<cidr notation>
LAN_NETWORK=192.168.1.0/24

## PLEX
# Go to plex.tv/claim and login with your account, copy the claim code (claim-xxxx...).
# Only needed when first claiming the server on a new account; blank it again afterwards.
PLEX_CLAIM_TOKEN=
# If you are a Plex Pass subscriber, you can enable the install of beta builds <true|false>
PLEX_BETA_INSTALL=false
# Helps local clients discover the server in bridge network mode — set to the UGREEN's LAN IP.
PLEX_ADVERTISE_URL="http://192.168.1.122:32400"

## Pullio - Auto update docker-compose the correct way.
# Setup https://hotio.dev/pullio/ — on UGOS, schedule the Pullio script via the UGOS Task Scheduler.
PULLIO_UPDATE=true
# Discord webhook notifications only; leave blank to disable notifications.
PULLIO_NOTIFY=true
PULLIO_DISCORD_WEBHOOK=
